#!/bin/sh
# Fake umu-run for vortex-core tests (ARCHITECTURE section 13). Not used by the app.
#
# Records to $FAKE_UMU_OUT (if set): "cwd=<PWD>" then one "arg=<arg>" line per argument; the full
# environment goes to "$FAKE_UMU_OUT.env". Behaviour: $FAKE_UMU_MODE, comma-separated steps run in
# order (default exit:0):
#   exit:N     exit with N (the kernel keeps the low 8 bits, like real umu-run)
#   sleep:S    sleep S seconds
#   lines:N    print "line 1".."line N" on stdout
#   secret     print a token line (redaction test)
#   orphan:S   start `setsid sleep S` (inherits the marker env, holds no pipe) and record its pid
#              in $WINEPREFIX/fake-wineserver.pid so the fake wineserver -w waits for it
#   stray:S    like orphan but not known to the fake wineserver (outlives the barrier)
#   protonlog  if $PROTON_LOG_DIR is set (verbose run), write steam-0.log there like Proton does:
#              a token line and a WINEDEBUG=warn+file "not found" line for $PWD/data3.bin
#   trap       ignore SIGTERM and block (stop must escalate to SIGKILL)
#   respawn:S  start a helper WITHOUT the marker that, for S seconds, starts a marked
#              `sleep 0.5` every 0.05 s (marker processes that keep appearing after a stop, like
#              a respawning service); the last one ends ~0.5 s after S
if [ -n "${FAKE_UMU_OUT:-}" ]; then
  { printf 'cwd=%s\n' "$PWD"; for a in "$@"; do printf 'arg=%s\n' "$a"; done; } > "$FAKE_UMU_OUT"
  env > "$FAKE_UMU_OUT.env"
fi
pidf="$WINEPREFIX/fake-wineserver.pid"
code=0
IFS=,
set -f
for step in ${FAKE_UMU_MODE:-exit:0}; do
  case $step in
    exit:*) code=${step#exit:} ;;
    sleep:*) sleep "${step#sleep:}" ;;
    lines:*) i=1; while [ "$i" -le "${step#lines:}" ]; do echo "line $i"; i=$((i + 1)); done ;;
    secret) echo "GITHUB_TOKEN=ghp_abcdefghijklmnopqrstuvwxyz0123" ;;
    orphan:*)
      rm -f "$pidf"
      setsid sh -c 'echo $$ > "$1.tmp"; mv "$1.tmp" "$1"; exec sleep "$2"' _ "$pidf" "${step#orphan:}" \
        </dev/null >/dev/null 2>&1 &
      while [ ! -s "$pidf" ]; do sleep 0.01; done ;;
    stray:*) setsid sleep "${step#stray:}" </dev/null >/dev/null 2>&1 & ;;
    respawn:*)
      env -u VORTEX_RUN_ID M="$VORTEX_RUN_ID" S="${step#respawn:}" setsid sh -c '
        end=$(($(date +%s) + S))
        while [ "$(date +%s)" -lt "$end" ]; do VORTEX_RUN_ID=$M sleep 0.5 & sleep 0.05; done
      ' </dev/null >/dev/null 2>&1 & ;;
    protonlog)
      if [ -n "${PROTON_LOG_DIR:-}" ]; then
        w=$(printf '%s' "$PWD" | sed 's#/#\\\\#g')
        { echo "GITHUB_TOKEN=ghp_abcdefghijklmnopqrstuvwxyz0123"
          printf '0138:warn:file:NtCreateFile L"\\\\??\\\\Z:%s\\\\data3.bin" not found (c0000034)\n' "$w"
        } > "$PROTON_LOG_DIR/steam-0.log"
      fi ;;
    trap) trap '' TERM; sleep 600 </dev/null >/dev/null 2>&1 & wait ;;
    *) echo "fake-umu-run: unknown mode step $step" >&2; exit 99 ;;
  esac
done
exit "$code"
