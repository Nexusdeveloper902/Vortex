{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "separate-pull-requests": false,
  "plugins": [
    "cargo-workspace",
    { "type": "linked-versions", "groupName": "vortex", "components": ["vortex-core", "vortex-gtk"] }
  ],
  "packages": {
    "crates/vortex-core": { "release-type": "rust" },
    "crates/vortex-gtk": { "release-type": "rust", "changelog-path": "../../CHANGELOG.md" }
  }
}
